---
// Static shell for the word detail panel; content is filled in by
// src/lib/detail-panel.ts when a node is selected.
---

<div id="detail">
  <div class="dhead">
    <div class="glow" id="dglow"></div>
    <button class="dclose" id="dclose">✕</button>
    <div class="zh" id="d-zh"></div>
    <div class="row1"><span class="py" id="d-py"></span><span id="d-badges"></span></div>
    <button class="audio-btn" id="d-audio">
      <span class="pw">▶</span><span id="d-audio-t" data-i18n="playWordSoon">Nghe phát âm — sắp ra mắt</span>
    </button>
    <button class="known-btn" id="d-known">
      <span class="pw">✓</span><span id="d-known-t" data-i18n="markKnown">Đánh dấu đã thuộc</span>
    </button>
  </div>
  <div class="dbody">
    <div class="mean"><div class="en" id="d-en"></div><div class="vi vi-only" id="d-vi"></div></div>
    <div class="meta-grid">
      <div class="m"><div class="k" data-i18n="posLabel">Từ loại</div><div class="v" id="d-pos"></div></div>
      <div class="m vi-only"><div class="k">Hán–Việt</div><div class="v hv" id="d-hv"></div></div>
    </div>
    <div class="frequency-card" id="d-frequency">
      <div class="frequency-top">
        <div>
          <div class="k" data-i18n="frequencyRank">Xếp hạng tần suất</div>
          <div class="rank" id="d-freq-rank"></div>
        </div>
        <span class="badge pareto" id="d-freq-pareto">Top 20%</span>
      </div>
      <div class="rate" id="d-freq-rate"></div>
      <div class="source"><span data-i18n="freqSourceLabel">Nguồn hội thoại</span>: SUBTLEX-CH</div>
    </div>
    <div class="ex" id="d-ex">
      <div class="rh" data-i18n="example">Ví dụ · Example</div>
      <div class="ex-zh" id="d-ex-zh"></div>
      <div class="ex-py" id="d-ex-py"></div>
      <div class="ex-en" id="d-ex-en"></div>
      <div class="ex-vi vi-only" id="d-ex-vi"></div>
      <button class="ex-audio" id="d-ex-audio"><span class="pw">▶</span><span id="d-ex-audio-t" data-i18n="playSentSoon">Nghe câu — sắp có</span></button>
    </div>
    <div class="strokes" id="d-strokes">
      <div class="rh"><span data-i18n="strokes">笔顺 · Nét chữ</span>
        <button class="stroke-play" id="d-stroke-play">▶ Animate</button>
      </div>
      <div class="stroke-grid" id="d-stroke-grid"></div>
    </div>
    <div class="rel"><div class="rh" id="d-relh" data-i18n="related">Từ liên quan</div><div id="d-rel"></div></div>
  </div>
</div>
